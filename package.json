{
  "name": "pinax",
  "version": "0.1.0",
  "private": true,
  "description": "\"pinax\" is book manager. Never burn. Remember Alexandria.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --import tsx --watch src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/index.ts",
    "scan": "node --no-warnings=ExperimentalWarning --import tsx src/cli-scan.ts",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node --no-warnings=ExperimentalWarning --import tsx src/probe.ts",
    "covers": "node --no-warnings=ExperimentalWarning --import tsx src/cli-covers.ts",
    "whoami": "node --no-warnings=ExperimentalWarning --import tsx src/cli-whoami.ts",
    "published": "node --no-warnings=ExperimentalWarning --import tsx src/cli-published.ts",
    "inbox": "node --no-warnings=ExperimentalWarning --import tsx src/cli-inbox.ts",
    "pages": "node --no-warnings=ExperimentalWarning --import tsx src/cli-pages.ts",
    "split": "node --no-warnings=ExperimentalWarning --import tsx src/cli-split.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.13",
    "typescript": "^5.9"
  }
}
